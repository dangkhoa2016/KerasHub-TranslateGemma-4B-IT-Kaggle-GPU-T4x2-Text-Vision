# Model mounted by Kaggle Models/Datasets
MODEL_PATH=/kaggle/input/models/keras/translategemma/keras/translategemma_4b_it/1
# If the configured version directory disappears, search attached Kaggle model versions.
MODEL_AUTO_DISCOVER=true
HOST=0.0.0.0
PORT=7860

# T4x2: start one isolated model process on each GPU.
MAX_GPU_WORKERS=2
# T4x2 mode pins one isolated worker to each GPU.
GPU_IDS=0,1
ALLOW_CPU_FALLBACK=false
# Adaptive startup: cold/empty JAX cache => stagger; warm cache + enough
# available host RAM => start both GPU workers in parallel. Legacy
# STAGGER_WORKER_START remains accepted for older configs, but auto mode wins.
WORKER_START_MODE=auto
WORKER_PARALLEL_CACHE_MIN_BYTES=1000000
WORKER_PARALLEL_MIN_AVAILABLE_RAM_MB=24576
STAGGER_WORKER_START=true
WORKER_LOAD_TIMEOUT=900
MAX_WORKER_RESTARTS=1

# Queue, result retention, and HTTP limits
MAX_QUEUE_SIZE=32
MAX_STORE_SIZE=1000
RESULT_TTL_SECONDS=3600
MAX_INPUT_CHARS=20000
DEFAULT_OUTPUT_TOKENS=128
MAX_OUTPUT_TOKENS=1024
REQUEST_TIMEOUT=600
SHUTDOWN_TIMEOUT=300
MAX_REQUEST_BYTES=8388608

# Vision / image translation (OCR + translate). When enabled, each worker loads
# the full multimodal checkpoint and JAX_MEM_FRACTION must be >= 0.97 (the
# vision model uses ~14.6 GB of the 15.36 GB T4 VRAM).
VISION_ENABLED=true
MAX_IMAGE_BYTES=5242880
# Image header dimensions are validated before any pixel data is decompressed,
# which also protects against decompression bombs.
MAX_IMAGE_WIDTH=8192
MAX_IMAGE_HEIGHT=8192
MAX_IMAGE_PIXELS=20000000

# Reference measurements showed BF16 and FP16 hot throughput were effectively equal,
# so BF16 remains the known-stable default.
MODEL_DTYPE=bfloat16
# Temporary process-level override used by scripts/benchmark_dtype.sh.
# Leave unset here; do not persist benchmark choices accidentally.
# MODEL_DTYPE_OVERRIDE=float16

# Generation-shape stabilization: KerasHub generate() accepts a total
# max_length; quantizing it to a small set of buckets avoids compiling a new
# JAX executable for every slightly different prompt length. Bucket slack is
# trimmed back to the client's requested max_new_tokens after generation.
GENERATION_BUCKETING=true
GENERATION_LENGTH_BUCKETS=256,512,1024,1536,2048
GENERATION_BUCKET_STEP=512

# Warm the common text/vision buckets observed in the validated T4x2 run. Keep the
# output budget aligned with DEFAULT_OUTPUT_TOKENS so the first normal request
# can reuse the same compiled max_length instead of recompiling.
WARMUP_ENABLED=true
WARMUP_OUTPUT_TOKENS=128
WARMUP_TEXT_BUCKETS=256
WARMUP_VISION_BUCKETS=512

# Persistent JAX compilation cache. It lives outside the repository because
# cached executables are trusted machine-local artifacts and should not be committed.
JAX_COMPILATION_CACHE_DIR=/kaggle/working/.cache/translategemma-jax
JAX_PERSISTENT_CACHE_MIN_COMPILE_TIME_SECS=1
JAX_PERSISTENT_CACHE_MIN_ENTRY_SIZE_BYTES=-1

# JAX memory policy. Preallocate one contiguous VRAM pool sized by
# JAX_MEM_FRACTION. This is required on the current Kaggle T4 image
# (JAX 0.7.x): with PREALLOCATE=false the BFC allocator fragments and the
# warm-up compile fails with RESOURCE_EXHAUSTED OOM.
JAX_PREALLOCATE=true
JAX_MEM_FRACTION=0.97

# Authentication is enabled by default. Leave the keys blank: server.py
# creates persistent random values in data/api_key.txt and
# data/restart_secret.txt on first start.
API_AUTH_REQUIRED=true
API_KEY=""
RESTART_SECRET=""

# CUDA environment for non-notebook shells (SSH/terminal/container).
# A standard Kaggle notebook sets these already; exporting them here keeps
# scripts working from any shell. See the CUDA environment section in README.md.
PATH="/opt/bin:/usr/local/cuda/bin:$PATH"
LD_LIBRARY_PATH=/usr/local/nvidia/lib64:/usr/local/cuda/lib64
CUDA_HOME=/usr/local/cuda
NVIDIA_VISIBLE_DEVICES=all
